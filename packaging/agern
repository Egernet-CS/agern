cmd_upgrade() {
    local want="" force=0 channel="" file=""
    while [ $# -gt 0 ]; do
        case $1 in
            --force) force=1 ;;
            --version) shift; want=${1:?--version needs a value} ;;
            --version=*) want=${1#--version=} ;;
            --channel) shift; channel=${1:?--channel needs stable or main} ;;
            --channel=*) channel=${1#--channel=} ;;
            --file) shift; file=${1:?--file needs a path} ;;
            --file=*) file=${1#--file=} ;;
            -*) die "unknown option $1" ;;
            *) [ -z "$want" ] || die "only one version, please"; want=$1 ;;
        esac
        shift
    done
    want=${want#v}
    if [ -n "$want" ] && ! [[ $want =~ $SEMVER_RE ]]; then die "not a version: $want"; fi
    [ -n "$channel" ] && valid_channel "$channel"
    if [ -n "$file" ] && { [ -n "$want" ] || [ -n "$channel" ]; }; then die "--file cannot be combined with a version or channel"; fi
    if [ "$LAYOUT" = deb ]; then
        cmd_upgrade_deb "$channel" "$want" "$file" "$force"
    else
        [ -z "$file" ] || die "--file is for .deb installs"
        [ -z "$channel" ] || [ "$channel" = stable ] || die "the $channel channel is only published as a .deb"
        cmd_upgrade_tarball "$want" "$force"
    fi
}

cmd=${1:-}
[ $# -gt 0 ] && shift
case $cmd in
    start)
        need_root_for_service start
        svc_start
        wait_healthy
        ;;
    stop)
        need_root_for_service stop
        svc_stop
        info "stopped"
        ;;
    restart)
        need_root_for_service restart
        svc_restart
        wait_healthy
        ;;
    status) cmd_status ;;
    logs) cmd_logs "$@" ;;
    version | --version) cmd_version ;;
    upgrade) cmd_upgrade "$@" ;;
    rollback)
        if [ "$LAYOUT" = deb ]; then cmd_rollback_deb "$@"; else cmd_rollback_tarball; fi
        ;;
    doctor) cmd_doctor ;;
    setup-db) cmd_setup_db "$@" ;;
    auto-upgrade) cmd_auto_upgrade "$@" ;;
    run) cmd_run ;;
    activate) cmd_activate "$@" ;;
    '' | help | -h | --help) usage ;;
    *) usage >&2; exit 2 ;;
esac
