# Agern — the software factory. Copy to .env (development) or /etc/agern/agern.env (production)
# and fill in. See docs/ARCHITECTURE.md §3 for every variable.

# --- Required -------------------------------------------------------------------------------
# 32 random bytes, base64. Encrypts user secrets (AES-256-GCM). Generate with:
#   openssl rand -base64 32
# Losing it makes every stored credential and 2FA secret unreadable.
FACTORY_MASTER_KEY=
# The GitHub organization whose repositories are the projects.
FACTORY_GITHUB_ORG=Egernet-CS

# --- Database -------------------------------------------------------------------------------
# Production: a natively installed PostgreSQL (15 or newer) on the factory host (no Docker).
# Debian package: 'sudo agern setup-db' creates role and database and fills in these three. Or once:
#   sudo -u postgres createuser --pwprompt factory
#   sudo -u postgres createdb --owner=factory factory
# Flyway creates/migrates the schema on every startup.
FACTORY_DB_URL=jdbc:postgresql://localhost:5432/factory
FACTORY_DB_USER=factory
FACTORY_DB_PASSWORD=factory
# Development only: throwaway database from docker-compose.dev.yml
#   docker compose -f docker-compose.dev.yml up -d
# FACTORY_DB_URL=jdbc:postgresql://localhost:54329/factory

# --- Network --------------------------------------------------------------------------------
# Bind address. A specific LAN address also gets a 127.0.0.1 listener (agents reach MCP over loopback).
FACTORY_HOST=0.0.0.0
FACTORY_PORT=8080
# The URL people type in their browser. The session cookie is Secure only when this is https.
# Mutating requests and WebSockets whose Origin differs from it are rejected.
FACTORY_PUBLIC_URL=http://localhost:8080
# Extra allowed browser origins, comma separated (e.g. the Vite dev server).
# FACTORY_ALLOWED_ORIGINS=http://localhost:5173

# --- Login ----------------------------------------------------------------------------------
# Comma list of providers tried in order: os (PAM), ldap, dev
FACTORY_AUTH=os
FACTORY_ADMINS=
# Second factor (TOTP). 'required' (default) or 'off' — 'off' is accepted only with FACTORY_AUTH=dev.
FACTORY_2FA=required
# PAM service for 'os' login (default: chkpasswd on macOS, login elsewhere).
# FACTORY_PAM_SERVICE=login
# LDAP: either a DN template ...
# FACTORY_LDAP_URL=ldaps://ldap.example.com:636
# FACTORY_LDAP_USER_DN_TEMPLATE=uid={0},ou=people,dc=example,dc=com
# ... or search-then-bind:
# FACTORY_LDAP_BASE_DN=ou=people,dc=example,dc=com
# FACTORY_LDAP_USER_FILTER=(uid={0})
# FACTORY_LDAP_BIND_DN=cn=agern,ou=services,dc=example,dc=com
# FACTORY_LDAP_BIND_PASSWORD=
# Development only: static users (only read when 'dev' is in FACTORY_AUTH).
# FACTORY_DEV_USERS=alice:alice-pw,bob:bob-pw

# --- Agents ---------------------------------------------------------------------------------
FACTORY_DATA_DIR=./data
FACTORY_CLAUDE_BIN=claude
FACTORY_MAX_AGENTS_PER_USER=8
FACTORY_CHAT_IDLE_MINUTES=30
# Wall-clock limit per pipeline stage; a stage that runs longer is stopped and fails the run.
FACTORY_STAGE_TIMEOUT_MINUTES=60
# Chat attachments (stored in PostgreSQL): largest file, all files of one message, files per message.
# FACTORY_ATTACHMENT_MAX_MB=20
# FACTORY_ATTACHMENT_MAX_MESSAGE_MB=50
# FACTORY_ATTACHMENT_MAX_COUNT=10
# PATH handed to agent processes (default: the server's PATH).
# FACTORY_AGENT_PATH=/usr/local/bin:/usr/bin:/bin

# --- Sandboxes ------------------------------------------------------------------------------
# Per-run build/test containers in ROOTLESS Podman (docs/ARCHITECTURE.md §5 "Sandboxes"). Off by default.
# A project opts in with .agern/sandbox.yml; an admin must approve each version of that file.
# The agent itself still runs on the host: a sandbox is a toolchain, not a security boundary.
# FACTORY_SANDBOX=podman
# FACTORY_SANDBOX_PODMAN=podman
# Talk to a 'podman system service' instead of running podman locally (podman --url ...):
# FACTORY_SANDBOX_PODMAN_URL=unix:///run/user/1000/podman/podman.sock
# Rootless Podman with the cgroupfs manager applies CPU/memory/pids limits only below an explicit
# cgroup parent ('agern sandbox enable' sets this on .deb installs):
# FACTORY_SANDBOX_CGROUP_PARENT=/system.slice/agern-sandbox.service/containers
# Registries images may come from; images must be fully qualified (docker.io/library/debian:12).
# FACTORY_SANDBOX_REGISTRIES=docker.io,ghcr.io,quay.io,mcr.microsoft.com
# Per-container caps (and defaults), sandboxes at the same time, and the limit per command.
# FACTORY_SANDBOX_MAX_CPUS=2
# FACTORY_SANDBOX_MAX_MEMORY=4g
# FACTORY_SANDBOX_MAX_CONCURRENT=2
# FACTORY_SANDBOX_EXEC_TIMEOUT_MINUTES=30

# --- Frontend -------------------------------------------------------------------------------
# Unset: serve the frontend embedded in agern.jar. Set: serve this directory instead.
# FACTORY_WEB_DIR=web/dist

# --- GitHub ---------------------------------------------------------------------------------
# GitHub Enterprise: https://ghe.example.com/api/v3
# FACTORY_GITHUB_API_URL=https://api.github.com
# Development only (requires FACTORY_AUTH=dev): in-memory fake GitHub; tokens 'fake-<login>' work.
# FACTORY_DEV_FAKE_GITHUB=true
