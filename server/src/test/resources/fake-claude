def owner_text(t):
    """The owner's own words of a forwarded message (the server prefixes it with who sent it)."""
    head = "Message from the run owner"
    return t.split("\n\n", 1)[1] if t.startswith(head) and "\n\n" in t else t


# Appended to reviewer summaries with "fake:markdown": every block type the run page renders, a long
# unbroken path for narrow screens, and HTML that must stay literal text.
MARKDOWN_TAIL = (
    "\n\n- **Checked:** `src/main/kotlin/a/very/long/path/that/must/wrap/on/narrow/screens/ExampleServiceImplementation.kt`"
    "\n- **Not run:** the *e2e* suite <img src=x onerror=alert(1)>"
    "\n\n1. first step\n2. second step"
    "\n\n```sh\n./gradlew build\n```"
    "\n\nSee [the docs](https://example.com/docs)."
)


def run_stage(prompt, checkpoint=lambda: None, received=()):
    """One pipeline stage's first turn. [checkpoint] is called between steps (after each tool round)."""
    init_event()
    if ("fake:fail-%s" % role) in prompt:
        sys.stderr.write("fake-claude: failing %s as requested\n" % role)
        sys.exit(1)
    if ("fake:hang-%s" % role) in prompt:
        stream_text("Thinking very hard (fake hang)...")
        while True:
            time.sleep(1)
    if "fake:slow" in prompt:
        time.sleep(1.5)
    if ("fake:busy-%s" % role) in prompt:
        for i in range(1, 301):
            tool_roundtrip("sleep 0.4; echo working, step %d" % i)
            checkpoint()
            if any("finish" in m for m in received):
                break
    markdown = "fake:markdown" in prompt
    md_tail = MARKDOWN_TAIL if markdown else ""
    if schema and "APPROVE" in schema:
        verdict = "ESCALATE" if "fake:escalate" in prompt else "APPROVE"
        summary = "Fake approver says %s." % verdict
        if markdown:
            summary += "\n\n- **Reason:** see `AGERN_FAKE.md`"
        out = {"verdict": verdict, "summary": summary}
        stream_text("Checked the change.")
        result(json.dumps(out), structured=out)
        return
    if schema and "PASS" in schema:
        shot = ""
        if "fake:screenshots" in prompt and role in ("ux", "ui-design") and mcp_config:
            shot = " " + attach_fake_screenshot(prompt)
        changes = "fake:always-changes" in prompt or ("fake:changes" in prompt and "after fix round" not in prompt)
        if changes:
            detail = "Fake finding from %s." % role
            if markdown:
                detail += "\n\n- rename `oldName` to **newName**"
            out = {"verdict": "CHANGES", "summary": "Fake %s reviewer wants changes." % role + shot + md_tail,
                   "findings": [{"severity": "major", "file": "AGERN_FAKE.md", "detail": detail}]}
        else:
            out = {"verdict": "PASS", "summary": "Fake %s reviewer is happy." % role + shot + md_tail, "findings": []}
        stream_text("Reviewed the diff.")
        result(json.dumps(out), structured=out)
        return
    if role == "builder":
        tool_roundtrip("git status --short | head -5")
        checkpoint()
        sandbox_report = ""
        if "fake:sandbox-long" in prompt and mcp_config:
            try:
                mcp_call("initialize", {"protocolVersion": "2025-06-18", "capabilities": {}, "clientInfo": {"name": "fake-claude", "version": "0"}}, 1)
                out, _ = mcp_tool_roundtrip("factory_sandbox_exec", {"command": "sleep long"}, 2)
                sandbox_report = "\nSandbox exec: %s" % out
            except Exception as e:  # noqa
                sandbox_report = "\nSandbox MCP calls failed: %s" % e
            checkpoint()
        elif "fake:sandbox-background" in prompt and mcp_config:
            try:
                mcp_call("initialize", {"protocolVersion": "2025-06-18", "capabilities": {}, "clientInfo": {"name": "fake-claude", "version": "0"}}, 1)
                started, _ = mcp_tool_roundtrip("factory_sandbox_exec", {"command": "sleep long", "background": True}, 2)
                handle = json.loads(started).get("handle", "")
                waited, _ = mcp_tool_roundtrip("factory_sandbox_wait", {"handle": handle}, 3)
                sandbox_report = "\nSandbox start: %s\nSandbox wait: %s" % (started, waited)
            except Exception as e:  # noqa
                sandbox_report = "\nSandbox MCP calls failed: %s" % e
            checkpoint()
        elif "fake:sandbox" in prompt and mcp_config:
            try:
                mcp_call("initialize", {"protocolVersion": "2025-06-18", "capabilities": {}, "clientInfo": {"name": "fake-claude", "version": "0"}}, 1)
                info, _ = mcp_tool_roundtrip("factory_sandbox_info", {}, 2)
                out, _ = mcp_tool_roundtrip("factory_sandbox_exec", {"command": "echo built in the sandbox && ls"}, 3)
                sandbox_report = "\nSandbox info: %s\nSandbox exec: %s" % (info, out)
                m = re.search(r"fake:platform=([a-z][a-z0-9-]*)", prompt)
                if m:
                    pout, _ = mcp_tool_roundtrip("factory_sandbox_exec", {"command": "echo built in the sandbox && ls", "platform": m.group(1)}, 4)
                    sandbox_report += "\nSandbox exec on %s: %s" % (m.group(1), pout)
            except Exception as e:  # noqa
                sandbox_report = "\nSandbox MCP calls failed: %s" % e
            checkpoint()
        image_report = ""
        if "fake:image" in prompt and mcp_config:
            answer, is_error = generate_fake_image(prompt, 5)
            image_report = "\nImage tool: " + answer
            if not is_error:
                try:
                    first = json.loads(answer)["images"][0]["path"]
                    os.makedirs("assets", exist_ok=True)
                    shutil.copyfile(first, os.path.join("assets", "fake-icon.png"))
                except Exception as e:  # noqa
                    image_report += "\nCopying the image failed: %s" % e
        image_report += prepared_report(prompt)
        if os.path.isdir(".git") or os.path.isfile(".git"):
            with open("AGERN_FAKE.md", "a") as f:
                f.write("fake build at %s\n" % time.strftime("%Y-%m-%dT%H:%M:%S"))
            subprocess.run(["git", "add", "AGERN_FAKE.md"], check=False)
            if "fake:ui-change" in prompt:
                os.makedirs(os.path.join("web", "src"), exist_ok=True)
                with open(os.path.join("web", "src", "FakeBanner.tsx"), "a") as f:
                    f.write("export const FakeBanner = () => <p>fake build at %s</p>;\n" % time.strftime("%Y-%m-%dT%H:%M:%S"))
                subprocess.run(["git", "add", os.path.join("web", "src", "FakeBanner.tsx")], check=False)
            if os.path.isfile(os.path.join("assets", "fake-icon.png")):
                subprocess.run(["git", "add", os.path.join("assets", "fake-icon.png")], check=False)
            subprocess.run(["git", "commit", "-q", "-m", "Fake build commit"], check=False)
        if "fake:stop-builder" in prompt and "Do not redo that work" not in prompt:
            text = "API Error: Can't reach the API server - check your internet or DNS (fake)"
            stream_text(text)
            result(text, subtype="error_during_execution", is_error=True)
            return
        text = "Implemented the change (fake). Ran no tests because I am a stub." + sandbox_report + image_report
        if received:
            text += "\nOwner messages handled: " + "; ".join(received)
        stream_text(text)
        result(text)
        return
    if role == "spec-writer":
        checkpoint()
        text = "## Summary\nA fake spec.\n\n## Acceptance criteria\n- [ ] Something happens\n"
        prepared = prepared_report(prompt)
        if prepared:
            text += "\n## Images" + prepared + "\n"
        if received:
            text += "\n## Notes from the owner\n" + "".join("- %s\n" % m for m in received)
        stream_text(text)
        result(text)
        return
    text = "Done (fake)."
    stream_text(text)
    result(text)


def one_shot():
    run_stage(sys.stdin.read())


def stage_stream_mode():
    """A spec-writer/builder with stream-json input: the first user message is the task, later ones steer it."""
    replay = "--replay-user-messages" in args
    inbox = queue.Queue()

    def reader():
        for line in sys.stdin:
            line = line.strip()
            if line:
                try:
                    inbox.put(json.loads(line))
                except ValueError:
                    pass
        inbox.put(None)

    threading.Thread(target=reader, daemon=True).start()
    received = []
    state = {"eof": False}

    def pick_up(m):
        if replay:
            emit({"type": "user", "message": m.get("message", {}), "session_id": session_id, "parent_tool_use_id": None,
                  "uuid": str(uuid.uuid4()), "timestamp": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "isReplay": True})
        c = m.get("message", {}).get("content", "")
        if isinstance(c, list):
            c = " ".join(b.get("text", "") for b in c if isinstance(b, dict) and b.get("type") == "text")
        return c

    def next_user(block):
        while True:
            if state["eof"]:
                return None
            try:
                m = inbox.get() if block else inbox.get_nowait()
            except queue.Empty:
                return None
            if m is None:
                state["eof"] = True
                return None
            if m.get("type") == "control_request":
                emit({"type": "control_response", "response": {"subtype": "success", "request_id": m.get("request_id"), "response": {}}})
                continue
            if m.get("type") == "user":
                return m

    def checkpoint():
        # Like the real CLI: what arrived during the current step is picked up before the next one.
        while True:
            m = next_user(False)
            if m is None:
                return
            t = owner_text(pick_up(m))
            received.append(t)
            stream_text("Noted the owner's message: " + t)

    first = next_user(True)
    if first is None:
        return
    run_stage(pick_up(first), checkpoint, received)
    # Messages that arrive after the last step start a further turn, each with its own result.
    while True:
        m = next_user(True)
        if m is None:
            return
        t = owner_text(pick_up(m))
        received.append(t)
        init_event()
        reply = "Follow-up from the owner handled: " + t
        stream_text(reply)
        result(reply)


